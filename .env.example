# =========================================================
# NovelForge 项目级环境变量模板
# 复制为 .env 后按需填写；.env 已被 .gitignore 排除，绝不提交
# =========================================================

# ---- LLM 服务商密钥（engine: direct 时必填，引擎=hermes 时可留空）----
# 腾讯云混元（OpenAI 兼容端点；控制台 API Key 页面创建）
# HUNYUAN_API_KEY=

# 其他 OpenAI 兼容服务商（按需在 config/system.yaml providers 登记后启用）
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# ---- 预算上限（元），超过后 orchestrator 自动熔断暂停 ----
# BUDGET_LIMIT_YUAN=300

# ---- 调试 ----
# 设为 1 时把每次直连请求/响应原文存 data/state/llm_raw/（含正文，勿提交）
# NOVELFORGE_DEBUG=0
