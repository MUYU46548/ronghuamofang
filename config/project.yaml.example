# =========================================================
# NovelForge 项目信息 —— **模板文件**
#
# 用法：复制成 config/project.yaml 再改（`cp config/project.yaml.example config/project.yaml`）。
#
# 为什么要有这份模板：`config/project.yaml` 承载你自己的书名 / 署名 / 剧情梗概，
# 属于**每本书都不一样**的活配置。公开发布时它会走 `git rm --cached`（移出跟踪），
# 若没有模板，干净克隆下来的人**首跑就会崩**（`load_project_yaml` 是裸 read_text，
# 缺文件直接 FileNotFoundError，没有兜底）。
#
# 每次运行前可修改。字段留空/删除大多有合理默认，见各字段注释。
# =========================================================

book:
  name: "示例书名（待填写）"        # 必填：成品文件名、合并稿标题都用它
  genre: "奇幻"
  # ★ 文体（2026-10-20）：决定**哪些判据适用**。默认 narrative，行为与以前完全一致。
  #   narrative = 叙事小说（主线/冲突/连续推进）
  #   letter    = 书信 / 日记体（时间可跳跃，语气比情节重要）
  #   episodic  = 单元 / 日常流（每章独立小事，弱主线）
  #   essay     = 散文 / 随笔集（篇篇独立，没有主线人物）
  # 不写 = narrative。写了不认识的值 → 回落 narrative 并在阶段入口**打印警告**（不静默）。
  # ⚠️ 只有判据口径按文体生效；各家文体的"写法指导"（stage4 文风块）还没接，
  #    散文/书信体目前能拿到正确的评分口径，但写作提示词仍是叙事口径。
  form: narrative
  # 需要微调判据适用范围时写这里（键可选：review_dims / aesthetic /
  # chapter_new_fields / deepen / foreshadow / volume / must_mention_character /
  # para_structure）。例如只要 5 维、不要深化段：
  # form_overrides:
  #   review_dims: [plot, reference, relation, persona, commonsense]
  #   deepen: false
  target_words: 300000              # 全书目标字数（供大纲阶段参考）
  style: "冷峻、克制、侧重行动与选择"
  chapters: 40                      # 目标章数：**总量用章数控制**，
                                    #   单章字数区间见 config/system.yaml 的 chapter.target_words
  language: "zh-CN"
  author: "你的名字"
  # 用户提供的大纲/梗概/核心构思（可选）。留空则系统基于素材自拟。
  # 多行写法：user_outline: |
  #   第一句点明核心设定……
  #   第二句点明主角弧光……
  user_outline: ""
  # Word 成品模板（可选）。放 templates/ 下（.dotx 或 .docx），stage7 以模板为底版：
  #   替换 [书籍标题]/[作者] 占位符、[目录占位符] 插入 TOC 域、正文写入 [请输入文本] 之后。
  #   更换模板 = 替换本字段路径或覆盖 templates/ 下文件，无需改代码。
  word_template: "templates/小说格式模板V1.3.dotx"
  # 风格参考文本（可选，写作阶段注入）。放 materials/ 下，1-2 篇你满意的范文/片段。
  #   配置了它，系统还会自动抽取代表性原文片段作为 few-shot 示例（自动避开与当前
  #   章节高度相似的段落，并标注来源位置）。留空则按模板文风要求。
  #   支持 .md / .txt；多篇请放在同一个文件里（路径是单值）。
  style_reference: ""
  # 文风规格（R22 拆锁，2026-10-29）：默认空 = 不注入任何风格块；
  # 可选 narrative / essay / letter / episodic（选了才注入 prompts/style/*_style.md）
  style_rule: ""
  # 范文注入上限（字，默认 6000，范围 1000~40000）。stage4 每章都要贴一遍，
  #   所以是每章都付的 token；超长时控制台 WARN 并写明丢弃字数（不再静默截断）。
  # style_reference_max_chars: 6000
  # 用户风格笔记（可选）。与自动分析结论叠加注入 stage4/stage6，冲突时以本节为准。
  #   控制台「设置」页签可直接编辑（保存前自动备份 config/history/）。
  style_notes: ""

materials:
  # 结构化素材卡目录（管线消费）：stage1 扫描此处并归并成设定集
  dir: "materials/raw"
  # 原始创作碎片目录（自由命名、私人数据、不进 Git）：只作 stage1 归并的额外输入，
  #   永不写进 materials/raw/。聚类/时间轴/前瞻备忘由 scrap_cluster.py 确定性生成。
  scraps_dir: "materials/original_scraps"
  # 是否启用碎片管线：true=自动（碎片为空时退化为普通流程）；false=完全忽略碎片
  use_scraps: true

vault:
  readonly: true                    # Obsidian 设定库只读（系统永不写入 vault）
  vault_links: "materials/vault_links.md"   # 设定库引用索引（阶段1 生成/维护）

run:
  output_word: true                 # 阶段7 是否转 Word（false 则仅输出 merged Markdown）
