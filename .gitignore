# ===== Python =====
.venv/
__pycache__/
*.pyc

# ===== 运行时数据（不进 Git，由 history/ 快照承担版本职责）=====
data/
history/

# ===== 成品输出（Word/Markdown 成品不进 Git）=====
output/

# ===== 日志与数据库 =====
logs/*.db
logs/*.log
logs/session.log

# ===== 环境变量（含密钥，绝不提交）=====
.env

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 临时与附件（不进 Git）=====
Temp/
.hermes/

# ===== 桌面控制台（Node 依赖与构建产物，本地安装即可） =====
console/node_modules/
console/renderer/dist/
console/dist/
console/build/
console/release/
*.exe
*.blockmap
*.yml
