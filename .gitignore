# ===== Python =====
.venv/
__pycache__/
*.pyc
*.pyo

# ===== 运行时数据（不进 Git，由 history/ 快照承担版本职责）=====
data/
history/

# ===== 用户放入的素材卡（不进 Git；materials/raw/README.md 除外，那是引导文档）=====
materials/raw/*.md
!materials/raw/README.md

# ===== 成品输出（Word/Markdown 成品不进 Git）=====
output/

# ===== 日志与数据库 =====
logs/*.db
logs/*.log
logs/session.log

# ===== 环境变量（含密钥，绝不提交）=====
.env

# ===== 系统文件 =====
.DS_Store
Thumbs.db

# ===== 临时与附件（不进 Git）=====
# 注意：tests/ 是**正式测试资产**，必须进 Git（2026-09-19 审查 B2 修复）。
# Temp/ 只剩截图/图标实验等一次性产物 —— 测试脚本已迁往 tests/。
Temp/
.hermes/

# ===== 用户私人数据（不进 Git，后续由"导入/导出"功能自行管理）=====
# 原始创作碎片：自由命名、含私人记忆线索，绝不随源码仓库走
materials/original_scraps/
# 碎片改写前的自动备份
materials/original_scraps/_backup/
# 碎片→卡片落盘时的同名覆盖备份
materials/raw/_backup/

# ===== 桌面控制台（Node 依赖与构建产物，本地安装即可） =====
console/node_modules/
console/renderer/dist/
console/dist/
# 注意：console/build/ 内是打包必需的**源资产**（icon.ico/icon.png/icon-512.png/
# icon-1024.png/favicon.png + NSIS 脚本 installer.nsh），不可忽略——否则 fresh clone
# 执行 npm run dist 会因缺图标而失败。构建产物请放 console/release/。
console/release/
console/runtime/
*.exe
*.blockmap
*.yml
# 例外：GitHub workflow 必须能被跟踪（否则第 53 行的 *.yml 会静默吞掉 CI 配置，
# 推不上仓库且不报错——2026-09-19 审查发现）
!.github/workflows/*.yml
!**/.github/workflows/*.yml

# ===== AI 助手工作区记忆（不进 Git，跨会话本地持久化）=====
.workbuddy/

# ===== 开发日志（不进 Git，纯开发草稿）=====
开发日志.md

# ===== 开发期临时产物（截图/草稿，不进 Git；正式文档截图放 docs/）=====
/*.png
/*.jpg
.agent_context/
